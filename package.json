{
  "name": "tfjs-credit-risk-classifier",
  "version": "1.0.0",
  "description": "Laboratório didático de classificação de risco de crédito com TensorFlow.js e uma rede neural MLP em Node.js: dataset real (German Credit/UCI) e sintético, normalização ajustada no treino, early stopping, matriz de confusão, ROC/AUC e ajuste do limiar por custo.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "start:ordinal": "node index.js --source=german-ordinal",
    "start:synthetic": "node index.js --source=synthetic",
    "cv": "node index.js --cv",
    "cv:synthetic": "node index.js --source=synthetic --cv",
    "fetch:german": "node scripts/fetch-german.js",
    "seed": "node scripts/seed.js",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "tensorflow",
    "tensorflowjs",
    "tfjs",
    "tfjs-node",
    "machine-learning",
    "deep-learning",
    "neural-network",
    "mlp",
    "multilayer-perceptron",
    "binary-classification",
    "credit-risk",
    "credit-scoring",
    "german-credit",
    "uci-dataset",
    "nodejs",
    "javascript",
    "educational",
    "one-hot-encoding",
    "fairness",
    "algorithmic-bias",
    "cross-validation",
    "stratified-sampling",
    "bias-mitigation"
  ],
  "author": {
    "name": "felpsdev03",
    "url": "https://github.com/Felps03"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felps03/tfjs-credit-risk-classifier.git"
  },
  "bugs": {
    "url": "https://github.com/Felps03/tfjs-credit-risk-classifier/issues"
  },
  "homepage": "https://github.com/Felps03/tfjs-credit-risk-classifier#readme",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
  }
}
