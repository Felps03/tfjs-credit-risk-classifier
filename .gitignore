# --------------------------------------------------
# Dependências
# --------------------------------------------------
node_modules/
jspm_packages/
.npm/
.yarn/
.pnp.*

# package-lock.json é versionado de propósito:
# garante que todos instalem exatamente a mesma
# versão do @tensorflow/tfjs-node.

# --------------------------------------------------
# TensorFlow.js
# --------------------------------------------------
# Binários nativos baixados pelo tfjs-node na instalação
# (ficam dentro de node_modules, mas às vezes vazam para a raiz)
*.node
lib/napi-v*/
libtensorflow*
tensorflow-*.tar.gz

# Modelos treinados e checkpoints
# (saída de model.save('file://./model'))
/model/
/models/
*.h5
*.pb
*.ckpt
saved_model/
weights.bin

# Logs do TensorBoard
/logs/
tfjs_logs/

# --------------------------------------------------
# Dados
# --------------------------------------------------
# data/customers.csv é versionado de propósito: o dataset fica estável
# entre execuções, os números do README batem com o que se vê ao rodar,
# e quem clona treina sem gerar nada antes. `npm start` só cria o arquivo
# se ele não existir; `npm run seed` regenera de propósito.
#
# Descomente se o dataset crescer a ponto de pesar no repositório:
# /data/

# --------------------------------------------------
# Variáveis de ambiente e segredos
# --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --------------------------------------------------
# Logs e artefatos de execução
# --------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
pids/
*.pid
*.seed

# --------------------------------------------------
# Testes e cobertura
# --------------------------------------------------
coverage/
.nyc_output/
*.lcov

# --------------------------------------------------
# Build e cache
# --------------------------------------------------
dist/
build/
out/
tmp/
temp/
.cache/

# --------------------------------------------------
# Editores e IDEs
# --------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace

# --------------------------------------------------
# Sistema operacional
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
